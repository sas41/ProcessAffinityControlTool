{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build (debug)",
      "type": "cargo",
      "command": "build",
      "args": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo build (release)",
      "type": "cargo",
      "command": "build",
      "args": ["--release"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo check",
      "type": "cargo",
      "command": "check",
      "args": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo test",
      "type": "cargo",
      "command": "test",
      "args": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo clippy",
      "type": "cargo",
      "command": "clippy",
      "args": ["--", "-D", "warnings"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "perf: allow sampling",
      "type": "shell",
      "command": "sudo sysctl -w kernel.perf_event_paranoid=1",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "cargo flamegraph",
      "type": "shell",
      "command": "cargo flamegraph --bin process_affinity_control_tool",
      "dependsOn": ["perf: allow sampling"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
